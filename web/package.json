{
  "name": "nx-guard",
  "version": "v1.0.8",
  "license": "Apache 2.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --serve-path /nxg/",
    "container": "ng serve --host 0.0.0.0 --serve-path /nxg/ --poll 2000",
    "container:prod": "ng serve --host 0.0.0.0 --configuration production --serve-path /nxg/",
    "build": "ng build --configuration production"
  },
  "private": true,
  "allowScripts": {
    "@parcel/watcher": true,
    "esbuild": true,
    "lmdb": true,
    "msgpackr-extract": true
  },
  "dependencies": {
    "@angular/animations": "^22.2.1",
    "@angular/cdk": "^22.2.1",
    "@angular/common": "^22.2.1",
    "@angular/compiler": "^22.2.1",
    "@angular/core": "^22.2.1",
    "@angular/forms": "^22.2.1",
    "@angular/material": "^22.2.1",
    "@angular/material-moment-adapter": "^22.2.1",
    "@angular/platform-browser": "^22.2.1",
    "@angular/platform-browser-dynamic": "^22.2.1",
    "@angular/router": "^22.2.1",
    "@ngx-translate/core": "^18.0.0",
    "@ngx-translate/http-loader": "^18.0.0",
    "chart.js": "^4.5.1",
    "chartjs-adapter-moment": "^1.0.1",
    "chartjs-plugin-datalabels": "^2.2.0",
    "chartjs-plugin-zoom": "^2.2.0",
    "file-saver": "^2.0.5",
    "flag-icons": "^7.5.0",
    "highlightjs-line-numbers.js": "^2.9.1",
    "jwt-decode": "^4.0.0",
    "material-icons": "^1.13.14",
    "moment": "^2.31.0",
    "ngx-highlightjs": "^14.0.1",
    "rxjs": "~7.8.2",
    "socket.io-client": "^4.8.4",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^22.2.1",
    "@angular/cli": "^22.2.1",
    "@angular/compiler-cli": "^22.2.1",
    "@types/file-saver": "^2.0.7",
    "@types/jasmine": "~7.0.0",
    "@types/node": "^26.6.4",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine-html-reporter": "~2.2.0",
    "typescript": "~6.0.3"
  }
