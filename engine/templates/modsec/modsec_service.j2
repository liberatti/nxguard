# MODSEC Config =================================
SecPcreMatchLimit 100000
SecPcreMatchLimitRecursion 100000
SecDataDir /tmp/modsec
SecRequestBodyAccess On
SecRequestBodyLimit {{ [((body_limit | int * 1048576) if body_limit else 10485760), 1073741824] | min }}
SecRequestBodyNoFilesLimit {{ [((body_limit | int * 1048576) if body_limit else 10485760), 1073741824] | min }}
SecRequestBodyLimitAction Reject
SecResponseBodyAccess On
SecResponseBodyLimitAction ProcessPartial
SecResponseBodyMimeType text/plain text/html text/xml application/json
SecArgumentSeparator &
SecCookieFormat 0
SecCollectionTimeout 600
SecAuditEngine RelevantOnly
SecAuditLogRelevantStatus "^(?:5|4(?!04))"
SecAuditLogParts {{ ((config.logging and config.logging.audit_log_parts) or 'ABHF') | upper | trim }}
SecAuditLogFormat JSON
SecAuditLogType Serial
SecDebugLogLevel 0

SecDefaultAction "phase:1,log,auditlog,pass"
SecDefaultAction "phase:2,log,auditlog,pass"
SecComponentSignature "OWASP_CRS/4.25.2"
SecAction "id:900010,phase:1,pass,nolog,noauditlog,t:none,setvar:tx.enforce_bodyproc_urlencoded=1"
SecAction "id:900320,phase:1,pass,nolog,noauditlog,t:none,setvar:tx.crs_setup_version=400"

SecAuditLog /opt/nxguard/logs/audit-{{ render_name }}.log
SecRule TX:/^MSC_/ "!@streq 0" "id:50,phase:1,deny,nolog,t:none,msg:'ModSecurity internal error flagged: %{MATCHED_VAR_NAME}'"
SecRule MULTIPART_UNMATCHED_BOUNDARY "!@eq 0" "id:51,phase:1,deny,log,t:none,msg:'Multipart parser detected a possible unmatched boundary.'"
SecRule REQUEST_METHOD "!@rx ^(?:GET|HEAD|OPTIONS)$" "id:52,phase:1,pass,nolog,t:none,chain"
  SecRule REQUEST_HEADERS:Content-Length "!@streq 0" "chain"
  SecRule REQUEST_HEADERS:Content-Type "(?:application(?:/soap\+|/)|text/)xml" "t:none,t:lowercase,ctl:requestBodyProcessor=XML"
SecRule REQUEST_METHOD "!@rx ^(?:GET|HEAD|OPTIONS)$" "id:53,phase:1,pass,nolog,t:none,chain"
  SecRule REQUEST_HEADERS:Content-Length "!@streq 0" "chain"
  SecRule REQUEST_HEADERS:Content-Type "(?:application/(?:[\w\.\-]+\+)?json)" "t:none,t:lowercase,ctl:requestBodyProcessor=JSON"
SecRule REQBODY_ERROR "!@eq 0" "id:55,severity:2,phase:2,deny,log,auditlog,t:none,msg:'Failed to parse request body.',logdata:'%{reqbody_error_msg}'"