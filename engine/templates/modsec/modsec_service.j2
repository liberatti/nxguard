# MODSEC Config =================================
SecPcreMatchLimit 10000
SecPcreMatchLimitRecursion 10000
SecDataDir /tmp/modsec
SecRequestBodyLimitAction Reject
SecRequestBodyAccess On
SecResponseBodyAccess On
SecResponseBodyLimitAction ProcessPartial
SecResponseBodyMimeType text/plain text/html text/xml application/json
SecArgumentSeparator &
SecCookieFormat 0
SecCollectionTimeout 600
SecAuditEngine On
SecRequestBodyLimit {{ body_limit }}
SecAuditLogParts ABHF
SecAuditLogFormat JSON
SecAuditLogType Serial
SecDebugLogLevel 0

SecDefaultAction "phase:1,log,auditlog,pass,t:urlDecodeUni,t:htmlEntityDecode"
SecDefaultAction "phase:2,log,auditlog,pass,t:urlDecodeUni,t:htmlEntityDecode"
SecComponentSignature "OWASP_CRS/4.25.1"
SecAction "id:900010,phase:1,pass,nolog,noauditlog,t:none,setvar:tx.enforce_bodyproc_urlencoded=1"
SecAction "id:900320,phase:1,pass,nolog,noauditlog,t:none,setvar:tx.crs_setup_version=400"

# Service

SecAuditLog /opt/nxguard/logs/audit-{{ name }}.log

SecRule TX:/^MSC_/ "!@streq 0" "id:50,phase:1,deny,nolog,t:none,msg:'ModSecurity internal error flagged: %{MATCHED_VAR_NAME}'"
SecRule MULTIPART_UNMATCHED_BOUNDARY "!@eq 0" "id:51,phase:1,deny,log,t:none,msg:'Multipart parser detected a possible unmatched boundary.'"
SecRule REQUEST_HEADERS:Content-Type "(?:application(?:/soap\+|/)|text/)xml" "id:52,phase:1,pass,nolog,t:none,t:lowercase,ctl:requestBodyProcessor=XML"
SecRule REQUEST_HEADERS:Content-Type "(?:application(?:/json\+|/))json" "id:53,phase:1,pass,nolog,t:none,t:lowercase,ctl:requestBodyProcessor=JSON"
SecRule REQBODY_ERROR "!@eq 0" "id:55,severity:2,phase:2,deny,nolog,t:none,ctl:requestBodyProcessor=JSON,msg:'Failed to parse request body.',logdata:'%{reqbody_error_msg}'"
