load_module {{BASE_PATH}}/nginx/modules/ngx_http_modsecurity_module.so;
load_module {{BASE_PATH}}/nginx/modules/ngx_http_sticky_module.so;
user nxguard nxguard;
pid {{BASE_PATH}}/run/nginx.pid;
worker_processes auto;
events {worker_connections 1024;}
http {
 lua_shared_dict log_buffer 16m;
 init_worker_by_lua_block {
   local flush = require "nxguard.log_flush"
   flush.start("{{BASE_PATH}}/logs/access.json", 2)  -- flush by 2s
 }
 #lua_shared_dict geoip_cache 10m;
 #lua_shared_dict si_68e91d2946043e189ab49b96_cache 10m;
 client_body_temp_path {{BASE_PATH}}/temp/client_body;
 fastcgi_temp_path {{BASE_PATH}}/temp/fastcgi;
 proxy_temp_path {{BASE_PATH}}/temp/proxy;
 scgi_temp_path {{BASE_PATH}}/temp/scgi;
 uwsgi_temp_path {{BASE_PATH}}/temp/uwsgi;
 access_log off;error_log /dev/null crit;
 proxy_intercept_errors on;
 include {%if IS_TEST%}test-{%-endif%}mime.types;
 default_type  application/octet-stream;
 sendfile on;
 keepalive_timeout 65;
 large_client_header_buffers 4 32k;
 map $host $missing_domain_match {
 {%- for s in services %}
  {%- for t in s.sans %}
    {{ t }} 0;
  {%- endfor %}
 {%-endfor %}
  default 1;
 }
 map $http_upgrade $connection_upgrade {default upgrade;'' close;}
 map '$scheme:$request_uri' $ssl_upgrade{
  ~^http:/\.well-known/acme-challenge/ 0;
  ~^http: 1;
  default 0;
 }
 proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
 include {%if IS_TEST%}test-{%-endif%}upstreams.conf;
 include {%if IS_TEST%}test-{%-endif%}monitor.conf;
 {%- for u in services %}
 include {%if IS_TEST%}test-{%-endif%}service-{{ u.name }}.conf;
 {%- endfor %}
}