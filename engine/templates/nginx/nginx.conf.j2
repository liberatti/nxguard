load_module {{BASE_PATH}}/nginx/modules/ngx_http_modsecurity_module.so;

user nxguard nxguard;
pid {{BASE_PATH}}/run/nginx.pid;
worker_processes auto;

events {
  worker_connections 1024;
}

http {
  server_tokens off;
  more_clear_headers Server;
  proxy_hide_header Server;

  merge_slashes on;
  {%- if config.dns_resolver %}
  resolver {{ config.dns_resolver }} valid=30s;
  {%- else %}
  resolver 127.0.0.11 8.8.8.8 valid=30s ipv6=off;
  {%- endif %}
  uninitialized_variable_warn off;
  lua_package_path "{{BASE_PATH}}/lualib/?.lua;{{BASE_PATH}}/lualib/?/init.lua;{{BASE_PATH}}/lualib/resty/?.lua;{{BASE_PATH}}/luajit/share/lua/5.1/?.lua;{{BASE_PATH}}/luajit/share/lua/5.1/?/init.lua;;";
  lua_package_cpath "{{BASE_PATH}}/lualib/?.so;{{BASE_PATH}}/luajit/lib/lua/5.1/?.so;;";
  lua_shared_dict log_buffer 2m;
  lua_shared_dict ipxa_cache 1m;
  lua_shared_dict healthcheck 2m;
  lua_socket_log_errors off;

  init_worker_by_lua_block {
    local flush = require "nxguard.log_flush"
    {%- if config.logging and config.logging.mode == 'elasticsearch' and config.logging.index_url %}
    flush.start_remote({
      url = "{{ config.logging.index_url }}",
      username = "{{ config.logging.index_username or '' }}",
      password = "{{ config.logging.index_password or '' }}",
      index = "{{ config.logging.index or 'nxguard_trn' }}",
      timeout = 5000
    }, 2)
    {%- else %}
    flush.start("{{BASE_PATH}}", 2)
    {%- endif %}

    local hc = require "resty.upstream.healthcheck"
    {%- for u in upstreams %}
    {%- if u.targets and u.targets|length > 0 %}
    local ok, err = hc.spawn_checker{
      shm = "healthcheck",
      upstream = "{{ u.render_name if u.render_name else u.name }}",
      type = "tcp",
      interval = 5000,
      timeout = 1000,
      fall = 3,
      rise = 1,
      concurrency = 1
    }
    if not ok then
      ngx.log(ngx.ERR, "failed to spawn health checker for {{ u.render_name if u.render_name else u.name }}: ", err)
    end
    {%- endif %}
    {%- endfor %}
  }

  client_body_temp_path {{BASE_PATH}}/temp/client_body;
  fastcgi_temp_path {{BASE_PATH}}/temp/fastcgi;
  proxy_temp_path {{BASE_PATH}}/temp/proxy;
  scgi_temp_path {{BASE_PATH}}/temp/scgi;
  uwsgi_temp_path {{BASE_PATH}}/temp/uwsgi;

  access_log off;
  error_log /dev/null crit;

  proxy_intercept_errors off;
  include mime.types;
  default_type application/octet-stream;
  sendfile on;
  keepalive_timeout 65;
  large_client_header_buffers 4 32k;

  map $host $missing_domain_match {
  {%- for s in services %}
  {%- if s.active %}
  {%- for t in s.sans %}
    {{ t }} 0;
  {%- endfor %}
  {%- endif %}
  {%- endfor %}
    default 1;
  }

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  map '$scheme:$request_uri' $ssl_upgrade {
    ~^http:/\.well-known/acme-challenge/ 0;
    ~^http: 1;
    default 0;
  }

  proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
  include upstreams.conf;

  server {
    listen 80 default_server;
    server_name _;
    return 503;
  }

  {%- for u in services %}
  {%- if u.active %}
  include service-{{ u.render_name if u.render_name else u.name }}.conf;
  {%- endif %}
  {%- endfor %}

  limit_req_status 429;
  error_page 429 = @rate_limited;
}