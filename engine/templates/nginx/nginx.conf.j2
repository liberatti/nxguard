load_module {{BASE_PATH}}/nginx/modules/ngx_http_modsecurity_module.so;
load_module {{BASE_PATH}}/nginx/modules/ngx_http_sticky_module.so;

user nxguard nxguard;
pid {{BASE_PATH}}/run/nginx.pid;
worker_processes auto;

events {
  worker_connections 1024;
}

http {
  server_tokens off;
  more_clear_headers Server;
  proxy_hide_header Server;

  merge_slashes on;
  resolver {{config.dns_resolver}} valid=30s;
  uninitialized_variable_warn off;
  lua_shared_dict log_buffer 2m;
  lua_shared_dict ipxa_cache 1m;

  init_worker_by_lua_block {
    local flush = require "nxguard.log_flush"
    flush.start("{{BASE_PATH}}", 2)  -- flush by 2s
  }

  client_body_temp_path {{BASE_PATH}}/temp/client_body;
  fastcgi_temp_path {{BASE_PATH}}/temp/fastcgi;
  proxy_temp_path {{BASE_PATH}}/temp/proxy;
  scgi_temp_path {{BASE_PATH}}/temp/scgi;
  uwsgi_temp_path {{BASE_PATH}}/temp/uwsgi;

  access_log off;
  error_log /dev/null crit;

  proxy_intercept_errors on;
  include mime.types;
  default_type application/octet-stream;
  sendfile on;
  keepalive_timeout 65;
  large_client_header_buffers 4 32k;

  map $host $missing_domain_match {
  {%- for s in services %}
  {%- if s.active %}
  {%- for t in s.sans %}
    {{ t }} 0;
  {%- endfor %}
  {%- endif %}
  {%- endfor %}
    default 1;
  }

  map $http_upgrade $connection_upgrade {
    default upgrade;
    '' close;
  }

  map '$scheme:$request_uri' $ssl_upgrade {
    ~^http:/\.well-known/acme-challenge/ 0;
    ~^http: 1;
    default 0;
  }

  proxy_next_upstream error timeout invalid_header http_500 http_502 http_503 http_504;
  include upstreams.conf;
  {%- for u in services %}
  {%- if u.active %}
  include service-{{ u.render_name if u.render_name else u.name }}.conf;
  {%- endif %}
  {%- endfor %}

  limit_req_status 429;
  error_page 429 = @rate_limited;
}