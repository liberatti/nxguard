 server {
  server_name 127.0.0.1;
  listen 5001;
  set $service 'monitor';
  set $upstream '-';
  set $route_name '-';
  set $sensor '-';
  set $geoip_status '-';
  set $rbl_status '-';
  set $real_method $request_method;
  access_log off;error_log /dev/null crit;
  location /ngx_up_status {
   add_header Content-Type application/json;
   allow 127.0.0.1;deny all;
   check_status json;
  }
  location /ngx_status {
   stub_status  on; allow 127.0.0.1;deny all;
   add_header Content-Type application/json;
   return 200 '{"active": $connections_active,"waiting": $connections_waiting}';
  }
}