upstream acme {
  server 127.0.0.1:5000 max_fails=3 weight=1 fail_timeout=300;
}

{%- for u in upstreams %}
upstream {{ u.render_name if u.render_name else u.name }} {
  check interval=5000 fall=3 rise=1 default_down=true type=tcp;
  {%- if u.persist %}
  {%- if u.persist.type == 'COOKIE' %}
  hash $cookie_{{ (u.persist.cookie_var or u.persist.cookie_name or 'LB_X_NxGuard') | replace('-', '_') }} consistent;
  {%- endif %}
  {%- endif %}
  {%- for t in u.targets %}
  server {{t.host}}:{{t.port}} max_fails=3 weight={{t.weight}} fail_timeout=300 {{t.state}};
  {%- endfor %}
}
{%- endif %}
{%- endfor %}
