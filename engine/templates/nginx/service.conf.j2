#####################################################################
# service: {{name}}
#####################################################################
{% if rate_limit_per_sec and rate_limit_per_sec > 0 %}
limit_req_zone $binary_remote_addr zone={{render_name if render_name else name}}_rate:16m rate={{rate_limit_per_sec}}r/s;
{% endif %}

proxy_cache_path {{BASE_PATH}}/cache/{{render_name if render_name else name}} keys_zone={{render_name if render_name else name}}_cache:10m use_temp_path=off loader_threshold=300 loader_files=200 max_size=128m;

server {
  lua_code_cache on;

  server_name {% for t in sans %}{{ t }}{% if not loop.last %} {% endif %}{% endfor %};

  # Enforce Host header and service name
  if ($missing_domain_match) { return 410; }

  # directory traversal protection
  if ($request_uri ~* "(\.\./|\.\.\\|%2e%2e%2f|%2e%2e/|\.\.%2f|%00)") { return 403; }

  # deny access to hidden files
  location ~ /\. {
    deny all;
    access_log off;
    log_not_found off;
  }

  {% if rate_limit_per_sec and rate_limit_per_sec > 0 %}
  limit_req zone={{render_name if render_name else name}}_rate burst=25 nodelay;
  {% endif %}

  set $service '{{render_name if render_name else name}}';
  set $real_method $request_method;
  client_max_body_size {{body_limit}}m;

  {% if compression_types and compression_types|length > 0 %}
{% include 'nginx/gzip.j2' %}
  {% endif %}

  proxy_no_cache $cookie_nocache $arg_nocache$arg_comment;
  proxy_no_cache $http_pragma    $http_authorization;
  proxy_request_buffering on;
  proxy_buffers 8 {{buffer}}k;
  proxy_buffer_size {{buffer}}k;
  proxy_busy_buffers_size {{buffer}}k;
  proxy_set_header Proxy "";

  add_header X-Request-Id $request_id always;
  {% for header in headers %}
  add_header {{ header.name }} '{{ header.content }}' always;
  {%- endfor %}

  modsecurity on;
  modsecurity_transaction_id "$request_id";
  {% if service_policy_file %}
  modsecurity_rules_file {{service_policy_file}};
  {% endif %}

  {% if ssl_enable %}
  ssl_protocols {% for t in ssl_protocols %}{{ t }}{% if not loop.last %} {% endif %}{% endfor %};
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384:ECDHE-RSA-AES128-SHA:ECDHE-RSA-AES256-SHA:DHE-RSA-AES128-SHA256:DHE-RSA-AES256-SHA256:DHE-RSA-AES128-SHA:DHE-RSA-AES256-SHA:!aNULL:!eNULL:!EXPORT:!DES:!RC4:!3DES:!MD5:!PSK;
  ssl_ecdh_curve secp384r1;
  ssl_stapling off;
  ssl_stapling_verify off;
  ssl_certificate {{BASE_PATH}}/keystore/{% if IS_TEST %}test-{% endif %}{{certificate.name}}.crt;
  ssl_certificate_key {{BASE_PATH}}/keystore/{% if IS_TEST %}test-{% endif %}{{certificate.name}}.key;
  {% endif %}

  location ^~ /.well-known/acme-challenge/ {
    default_type "text/plain";
    proxy_redirect off;
    proxy_pass http://acme;
    proxy_read_timeout 120s;
    proxy_connect_timeout 120s;
  }

  proxy_ssl_server_name on;
  proxy_ssl_verify off;

  {% for b in bindings %}
  {% if b.protocol == 'HTTP' %}
  listen {{b.port}};
  {% if b.ssl_upgrade %}
  if ($ssl_upgrade) { return 301 https://$server_name:{{b.ssl_upgrade_port if b.ssl_upgrade_port else 443}}$request_uri; }
  {% endif %}
  {% endif %}

  {% if ssl_enable and b.protocol == 'HTTPS' %}
  listen {{b.port}} ssl;
  {% endif %}
  {% endfor %}

  {% for r in routes %}
  {% for p in r.paths %}
  location ~ {{p}} {
    set $route '{{r.name}}';
    set $sensor '{{r.sensor.render_name if r.sensor and r.sensor.render_name else (r.sensor.name if r.sensor and r.sensor.name else "-")}}';
    {%- if r.type == 'UPSTREAM' and r.upstream and (r.upstream.render_name or r.upstream.name) %}
    set $upstream '{{r.upstream.render_name if r.upstream.render_name else r.upstream.name}}';
    {%- else %}
    set $upstream '-';
    {%- endif %}

    {% if r.sensor and (r.sensor.render_name or r.sensor.name) and r.sensor.ipxa_enabled %}
    access_by_lua_file {{BASE_PATH}}/luajit/share/lua/5.1/nxguard/sensors/{{r.sensor.render_name if r.sensor.render_name else r.sensor.name }}.lua;
    {% endif %}

    {%- if r.route_policy_file %}
    modsecurity_rules_file {{r.route_policy_file }};
    {% endif %}
    {%- if r.sensor and r.sensor_policy_file %}
    modsecurity_rules_file {{r.sensor_policy_file }};
    {% endif %}

    {%- if r.type == 'UPSTREAM' and r.upstream and (r.upstream.render_name or r.upstream.name) %}
    proxy_http_version 1.1;
    proxy_intercept_errors on;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $http_host;
    proxy_set_header X-Forwarded-Port $server_port;
    proxy_read_timeout {{timeout}}s;
    proxy_set_header Host $http_host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header Upgrade $http_upgrade;
    proxy_set_header Connection $connection_upgrade;
    proxy_redirect off;
    proxy_pass http://{{r.upstream.render_name if r.upstream.render_name else r.upstream.name}}/$1$is_args$args;
    {%- endif %}

    {%- if r.type == 'REDIRECT' %}
    return 301 "{{r.redirect.url}}";
    {%- endif %}
  }
  {% endfor %}
  {% endfor %}

  error_page 404 403 500 502 503 504 @custom_error;
  location @custom_error {
    content_by_lua_file {{BASE_PATH}}/luajit/share/lua/5.1/nxguard/content_by_custom_error.lua;
  }

  location @rate_limited {
    add_header X-RateLimit-Triggered true;
    return 429;
  }

  access_log off;
  error_log /opt/nxguard/logs/error-{{name}}.log warn;
  log_by_lua_file {{BASE_PATH}}/luajit/share/lua/5.1/nxguard/log_by_custom.lua;
}
