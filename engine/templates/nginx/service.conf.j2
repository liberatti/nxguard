 # service: {{name}}
{%- if rate_limit %}
limit_req_zone $binary_remote_addr zone={{name}}_rate:16m rate={{rate_limit_per_sec}}r/s;
{%- endif %}
proxy_cache_path /opt/nxguard/cache/{{name}} keys_zone={{name}}_cache:10m use_temp_path=off loader_threshold=300 loader_files=200 max_size=128m;
server {
  lua_code_cache on;
  server_name {% for t in sans %}{{ t }} {% endfor %};
  if ($missing_domain_match) {return 410;}
  {%- if rate_limit %}
  limit_req zone={{name}}_rate burst=25 nodelay;
  {%- endif %}
  set $service '{{name}}';
  set $upstream '-';
  set $route_name '-';
  set $sensor '-';
  set $geoip_status '-';
  set $rbl_status '-';
  set $real_method $request_method;
  client_max_body_size {{body_limit}}m;
  {%- if compression %}
  gzip on;
  gzip_min_length 1000;
  gzip_disable 'msie6';
  gzip_proxied no-cache no-store expired;
  gzip_types {% for t in compression_types %}{{ t }} {% endfor %};
  {%endif%}
  proxy_no_cache $cookie_nocache $arg_nocache$arg_comment;
  proxy_no_cache $http_pragma    $http_authorization;
  proxy_request_buffering on;
  proxy_buffers 8 {{buffer}}k;
  proxy_buffer_size {{buffer}}k;
  proxy_busy_buffers_size {{buffer}}k;
  add_header X-Request-Id $request_id always;
  {%- for header in headers %}
  add_header {{ header.name }} {{ header.content }} always;
  {%- endfor %}

  modsecurity on;
  modsecurity_transaction_id "$request_id";
  modsecurity_rules_file /opt/nxguard/modsec/conf/config.policy;
  modsecurity_rules_file /opt/nxguard/modsec/conf/service-proxy.policy;
  modsecurity_rules_file /opt/nxguard/modsec/conf/crs.policy;

  {%- if ssl_enable %}
  ssl_protocols {% for t in ssl_protocols %}{{ t }} {% endfor %};
  ssl_prefer_server_ciphers on;
  ssl_session_cache shared:SSL:10m;
  ssl_session_timeout 10m;
  ssl_ciphers ECDHE-RSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384:ECDHE-RSA-AES128-SHA:ECDHE-RSA-AES256-SHA:DHE-RSA-AES128-SHA256:DHE-RSA-AES256-SHA256:DHE-RSA-AES128-SHA:DHE-RSA-AES256-SHA:!aNULL:!eNULL:!EXPORT:!DES:!RC4:!3DES:!MD5:!PSK;
  ssl_ecdh_curve secp384r1;
  ssl_stapling off;
  ssl_stapling_verify off;
  ssl_certificate /opt/nxguard/keystore/{{certificate.name}}.crt;
  ssl_certificate_key /opt/nxguard/keystore/{{certificate.name}}.key;
  {%- endif %}

  location ^~ /.well-known/acme-challenge/ {
   default_type "text/plain";
   proxy_redirect off;
   proxy_pass http://acme;
   proxy_read_timeout 120s;
   proxy_connect_timeout 120s;
   modsecurity_rules '
    SecRuleRemoveById 920272
   ';
  }
  proxy_ssl_server_name on;
  proxy_ssl_verify off;

  {%- for b in bindings %}
  {%- if b.protocol == 'HTTP' %}
  listen {{b.port}};
  {%- endif %}
  {%- if b.protocol == 'HTTPS' %}
  listen {{b.port}} ssl;
  {%- if b.ssl_upgrade %}
  if ($ssl_upgrade) {return 301 https://$server_name:{{b.port}}$request_uri;}
  {%- endif %}
  {%- endif %}
  {%- endfor %}
{%- for r in routes %}
{%- for p in r.paths %}
  location ~ {{p}}{
   set $sensor_id '{{r.sensor.name}}';
   set $route_name '{{r.name}}';
   set $api_url 'http://127.0.0.1:5000/api';
   set $api_key VdE436BuYsgScw2WqoqDcisRfn0zBo0O;
   access_by_lua_file  /opt/nxguard/lualib/share/lua/5.4/nxguard/deny_by_sensor.lua;
   modsecurity_rules_file /opt/nxguard/modsec/conf/route-proxy-all-req.policy;
   set $upstream_id '{{r.upstream.name}}';
   proxy_http_version 1.1;
   proxy_intercept_errors on;
   proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
   proxy_read_timeout {{timeout}}s;
   proxy_set_header Host $host;
   proxy_set_header X-Real-IP $remote_addr;
   proxy_set_header Upgrade $http_upgrade;
   proxy_set_header Connection $connection_upgrade;
   proxy_redirect off;
   proxy_pass http://proxy/$1$is_args$args;
  }
{%- endfor %}
{%- endfor %}

  access_log /opt/nxguard/logs/access_log-{{name}}.log logger-json;
  error_log /opt/nxguard/logs/error_log-{{name}}.log;
  error_page 404 403 500 502 503 504 /custom_error;
  location = /custom_error {
   internal;
   content_by_lua_file /opt/nxguard/lualib/share/lua/5.4/nxguard/content_by_custom_error.lua;
  }
}
